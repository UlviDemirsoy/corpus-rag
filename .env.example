# OpenAI
OPENAI_API_KEY=sk-...

# Postgres (local Compose: @localhost). Vercel prod: Neon Marketplace → DATABASE_URL.
DATABASE_URL=postgresql://rag:rag@localhost:5432/rag

# Qdrant (local Compose: http://localhost:6333). Vercel prod: Qdrant Cloud cluster URL.
QDRANT_URL=http://localhost:6333
# Required for Qdrant Cloud (and any secured Qdrant). Leave empty for local Compose.
QDRANT_API_KEY=

# Auth
BETTER_AUTH_SECRET=change-me-to-a-long-random-string-at-least-32-chars
# Local: same-origin via Next :3000 rewrite. Vercel: set both to https://<your-deployment>
# (or rely on VERCEL_URL / VERCEL_PROJECT_PRODUCTION_URL defaults when unset).
BETTER_AUTH_URL=http://localhost:3000
WEB_ORIGIN=http://localhost:3000
# Optional Google OAuth (both required to enable "Continue with Google")
# Redirect URIs in Google Cloud Console:
#   http://localhost:3000/api/auth/callback/google
#   https://<your-vercel-domain>/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Optional automation Bearer for /mcp (interactive clients use OAuth login)
MCP_API_KEY=

# API
PORT=3001
NODE_ENV=development
LOG_LEVEL=info

# Ingestion / RAG
CORPUS_PATH=./data/corpus
CHUNK_STRATEGY=recursive
EMBEDDING_MODEL=text-embedding-3-small
CHAT_MODEL=gpt-4o-mini
TOP_K=5
RERANK_ENABLED=true
RERANK_CANDIDATES=20
HYBRID_ENABLED=true
HYBRID_ALPHA=0.5

# Boot behaviour
# On Vercel (VERCEL=1) AUTO_INGEST / CORPUS_WATCH default to false even if omitted —
# run a one-shot admin ingest after first deploy (see README Deployment).
AUTO_INGEST=true
AUTO_INGEST_ALL_STRATEGIES=true
SEED_ON_BOOT=true

# Self-updating pipeline (watch CORPUS_PATH → incremental re-index). Local/Docker only.
CORPUS_WATCH=true
CORPUS_WATCH_ALL_STRATEGIES=false
CORPUS_WATCH_DEBOUNCE_MS=2500

# Demo seed passwords
DEMO_USER_PASSWORD=user1234
DEMO_ADMIN_PASSWORD=admin1234
