# OpenAI
OPENAI_API_KEY=sk-...

# Postgres (host machine / local). Docker Compose overrides to @postgres for the api service.
DATABASE_URL=postgresql://rag:rag@localhost:5432/rag

# Qdrant (host). Docker Compose overrides to http://qdrant:6333 for the api service.
QDRANT_URL=http://localhost:6333

# Auth
BETTER_AUTH_SECRET=change-me-to-a-long-random-string-at-least-32-chars
BETTER_AUTH_URL=http://localhost:3000
WEB_ORIGIN=http://localhost:3000
# Optional Google OAuth (both required to enable "Continue with Google")
# Redirect URI in Google Cloud Console:
#   http://localhost:3000/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# API
PORT=3001
NODE_ENV=development
LOG_LEVEL=info

# Ingestion / RAG
CORPUS_PATH=./data/corpus
CHUNK_STRATEGY=recursive
EMBEDDING_MODEL=text-embedding-3-small
CHAT_MODEL=gpt-4o-mini
TOP_K=5
RERANK_ENABLED=true
RERANK_CANDIDATES=20
HYBRID_ENABLED=true
HYBRID_ALPHA=0.5

# Boot behaviour
AUTO_INGEST=true
AUTO_INGEST_ALL_STRATEGIES=true
SEED_ON_BOOT=true

# Self-updating pipeline (watch CORPUS_PATH → incremental re-index)
CORPUS_WATCH=true
CORPUS_WATCH_ALL_STRATEGIES=false
CORPUS_WATCH_DEBOUNCE_MS=2500

# Demo seed passwords
DEMO_USER_PASSWORD=user1234
DEMO_ADMIN_PASSWORD=admin1234
