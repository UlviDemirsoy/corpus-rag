# Copy to .env and fill in values (never commit .env)

# OpenAI
OPENAI_API_KEY=

# Postgres (local Compose: postgresql://rag:rag@localhost:5432/rag)
DATABASE_URL=

# Qdrant (local: http://localhost:6333)
QDRANT_URL=
QDRANT_API_KEY=

# Auth (BETTER_AUTH_SECRET: random string, at least 32 chars)
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=
WEB_ORIGIN=

# Optional Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Optional automation Bearer for /mcp (interactive clients use OAuth login)
MCP_API_KEY=

# API
PORT=3001
NODE_ENV=development
LOG_LEVEL=info

# Ingestion / RAG
CORPUS_PATH=./data/corpus
CHUNK_STRATEGY=recursive
EMBEDDING_MODEL=text-embedding-3-small
CHAT_MODEL=gpt-4o-mini
TOP_K=5
RERANK_ENABLED=true
RERANK_CANDIDATES=20
HYBRID_ENABLED=true
HYBRID_ALPHA=0.5

# Boot behaviour
AUTO_INGEST=true
AUTO_INGEST_ALL_STRATEGIES=true
SEED_ON_BOOT=true

# Self-updating pipeline (local/Docker only)
CORPUS_WATCH=true
CORPUS_WATCH_ALL_STRATEGIES=false
CORPUS_WATCH_DEBOUNCE_MS=2500

# Demo seed passwords (change in production)
DEMO_USER_PASSWORD=
DEMO_ADMIN_PASSWORD=
